  68:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** static void UVCL_SendPacket(UVCL_Ctx_t *p_ctx, UX_DEVICE_CLASS_VIDEO_STREAM *stream, int len)
  69:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** {
  70:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   ULONG buffer_length;
  71:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UCHAR *buffer;
  72:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   int ret;
  73:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
  74:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   ret = ux_device_class_video_write_payload_get(stream, &buffer, &buffer_length);
  75:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   assert(ret == UX_SUCCESS);
  76:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   assert(buffer_length >= len);
  77:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
  78:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   memcpy(buffer, p_ctx->packet, len);
  79:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   ret = ux_device_class_video_write_payload_commit(stream, len);
  80:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   assert(ret == UX_SUCCESS);
  81:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** }
