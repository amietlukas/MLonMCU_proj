  83:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** static void UVCL_DataIn(struct UX_DEVICE_CLASS_VIDEO_STREAM_STRUCT *stream)
  84:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** {
  85:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   int packet_size = is_hs() ? UVC_ISO_HS_MPS : UVC_ISO_FS_MPS;
  86:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_Ctx_t *p_ctx = UVCL_usbx_get_ctx_from_stream(stream);
  87:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_OnFlyCtx_t *on_fly_ctx;
  88:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   int len;
  89:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
  90:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (p_ctx->state != UVCL_STATUS_STREAMING)
  91:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   {
  92:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     return ;
  93:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   }
  94:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
  95:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   /* select new frame */
  96:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (!p_ctx->on_fly_ctx)
  97:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     p_ctx->on_fly_ctx = UVCL_StartNewFrameTransmission(p_ctx, packet_size);
  98:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
  99:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (!p_ctx->on_fly_ctx) {
 100:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     UVCL_SendPacket(p_ctx, stream, 2);
 101:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     return ;
 102:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   }
 103:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 104:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   /* Send next frame packet */
 105:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   on_fly_ctx = p_ctx->on_fly_ctx;
 106:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   //printf("S %d\n", on_fly_ctx->packet_index);
 107:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   len = on_fly_ctx->packet_index == (on_fly_ctx->packet_nb - 1) ? on_fly_ctx->last_packet_size + 2 
 108:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   memcpy(&p_ctx->packet[2], on_fly_ctx->cursor, len - 2);
 109:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_SendPacket(p_ctx, stream, len);
 110:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 111:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_UpdateOnFlyCtx(p_ctx, len);
 112:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** }
 113:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 114:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** static void UVCL_StopStreaming(struct UX_DEVICE_CLASS_VIDEO_STREAM_STRUCT *stream)
 115:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** {
 116:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_Ctx_t *p_ctx = UVCL_usbx_get_ctx_from_stream(stream);
 117:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 118:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->state = UVCL_STATUS_STOP;
 119:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (p_ctx->on_fly_ctx)
 120:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     UVCL_AbortOnFlyCtx(p_ctx);
 121:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 122:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   /* Also release queue frame */
 123:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (p_ctx->p_frame) {
 124:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****      p_ctx->cbs->frame_release(p_ctx->cbs, p_ctx->p_frame);
 125:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****      p_ctx->p_frame = NULL;
 126:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   }
 127:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 128:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (p_ctx->cbs->streaming_inactive)
 129:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     p_ctx->cbs->streaming_inactive(p_ctx->cbs);
 130:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** }
 131:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 132:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** static void UVCL_StartStreaming(struct UX_DEVICE_CLASS_VIDEO_STREAM_STRUCT *stream)
 133:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** {
 134:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_Ctx_t *p_ctx = UVCL_usbx_get_ctx_from_stream(stream);
 135:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_StreamConf_t stream_param;
 136:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   int i;
 137:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 138:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   UVCL_SetupStreamingStream(p_ctx, &stream_param);
 139:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   if (p_ctx->cbs->streaming_active)
ARM GAS  /tmp/claude-1000/ccISxWHP.s 			page 4


 140:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     p_ctx->cbs->streaming_active(p_ctx->cbs, stream_param);
 141:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 142:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->frame_period_in_ms = 1000 / stream_param.fps;
 143:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->packet[0] = 2;
 144:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->packet[1] = 0;
 145:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->frame_start = HAL_GetTick() - p_ctx->frame_period_in_ms;
 146:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->is_starting = 1;
 147:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   p_ctx->state = UVCL_STATUS_STREAMING;
 148:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** 
 149:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****   for (i = 0; i < p_ctx->buffer_nb; i++)
 150:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c ****     UVCL_DataIn(stream);
 151:../../Middlewares/screenl/uvcl/Src/usbx/uvcl_usbx.c **** }
