 142:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** static void isp_ae_reverse_antiflicker(uint32_t gain, uint32_t exposure,
 143:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****                                        uint32_t *original_gain, uint32_t *original_exposure)
 144:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** {
 145:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   /* Get equivalent gain/exposure where exposure has a maximum value (reverse processing of the abo
 146:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   float compensation_gain;
ARM GAS  /tmp/claude-1000/ccVtSW6D.s 			page 5


 147:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   uint32_t global_exposure;
 148:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** 
 149:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   /* Compute adjusted_gain and exposure in any case even if antiflicker is disabled
 150:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****    * This way, in case there is no light condition change, previous adjustment for antiflicker
 151:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****    * will be removed */
 152:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** 
 153:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   global_exposure = (uint32_t)(exposure * pow(10, (float)gain / (20 * 1000)));
 154:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   if (global_exposure < pSensorInfo->exposure_max)
 155:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   {
 156:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     *original_gain = 0;
 157:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     *original_exposure = global_exposure;
 158:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     /* Fix rounding error when close to max value */
 159:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     if (*original_exposure > 0.98 * pSensorInfo->exposure_max)
 160:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     {
 161:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****       *original_exposure = pSensorInfo->exposure_max;
 162:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     }
 163:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   }
 164:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   else
 165:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   {
 166:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     /* Set exposure to max, and compute the compensation gain */
 167:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     *original_exposure = pSensorInfo->exposure_max;
 168:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     /* Increase the gain accordingly */
 169:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     compensation_gain = (float)global_exposure / (float)*original_exposure;
 170:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****     *original_gain = (uint32_t)(20 * 1000 * log10(compensation_gain));
 171:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   }
 172:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** }
 173:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** 
 174:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** /**
 175:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @brief  isp_ae_get_new_exposure
 176:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         This function computes the new sensor exposure to be applied
 177:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         for a given lux and a given luminance target
 178:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         This function is implemented in accordance with the exposure estimation
 179:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         principles based on the estimated lux value of the current scene.
 180:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         There are 3 models of new sensor exposure estimation used in this AE algorithm:
 181:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         - Estimation 1 is used for values above 𝐿𝑢𝑥𝑅𝑒𝑓_𝐻𝐿
 182:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         - Estimation 2 is used for values below 𝐿𝑢𝑥𝑅𝑒𝑓_𝐻𝐿 and above �
 183:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         - Estimation 3 is used for values from 0 to 𝑐𝑢𝑠𝑡𝑜𝑚_𝑙𝑜𝑤_𝑙�
 184:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *           𝑐𝑢𝑠𝑡𝑜𝑚_𝑙𝑜𝑤_𝑙𝑢𝑥_𝑙𝑖𝑚𝑖𝑡 should be set
 185:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *           𝑎_𝐿𝐿×𝑙𝑢𝑚_𝑡𝑎𝑟𝑔𝑒𝑡×𝑐𝑎𝑙𝑖𝑏𝐹𝑎�
 186:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         Two types of convergence are targeted:
 187:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         - COARSE CONVERGENCE: in the 1st iteration, the exposure calculation brings
 188:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *           the luminance value close to the target
 189:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *         - FINE CONVERGENCE: in the following iteration,  if fine convergence has not been
 190:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *           achieved yet with the previous calculation, small increments are applied to
 191:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   *           reach high accuracy.
 192:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @param  lux      : current lux value of the captured scene
 193:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @param  averageL : current average luminance statistic
 194:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @param  pExposure: pointer to the new exposure time value (us)
 195:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @param  pGain    : pointer to the new sensor gain value (mdB)
 196:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @param  exposure : current sensor exposure time value (us)
 197:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @param  gain     : current sensor gain value (mdB)
 198:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   * @retval None
 199:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c ****   */
 200:../../Middlewares/stm32-mw-camera/ISP_Library/isp/Src/isp_ae_algo.c **** void isp_ae_get_new_exposure(uint32_t lux, uint32_t averageL, uint32_t *pExposure, uint32_t *pGain,
