 284:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****   for (value >>= 1U; value != 0U; value >>= 1U)
 285:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****   {
