   1:Src/motor_control.c **** /**
   2:Src/motor_control.c ****  ******************************************************************************
   3:Src/motor_control.c ****  * @file    motor_control.c
   4:Src/motor_control.c ****  * @brief   Differential-drive motor control ported from paul_car.ino.
   5:Src/motor_control.c ****  *          See motor_control.h for the Arduino-header -> STM32 pin mapping.
   6:Src/motor_control.c ****  ******************************************************************************
   7:Src/motor_control.c ****  */
   8:Src/motor_control.c **** #include "main.h"
   9:Src/motor_control.c **** #include "motor_control.h"
  10:Src/motor_control.c **** 
  11:Src/motor_control.c **** /* ---- Direction GPIOs (HIGH/LOW like Arduino digitalWrite) ---------------- */
  12:Src/motor_control.c **** #define LB_PORT  GPIOD
  13:Src/motor_control.c **** #define LB_PIN   GPIO_PIN_0      /* D2  pinLB */
  14:Src/motor_control.c **** #define LF_PORT  GPIOE
  15:Src/motor_control.c **** #define LF_PIN   GPIO_PIN_0      /* D4  pinLF */
  16:Src/motor_control.c **** #define RB_PORT  GPIOE
  17:Src/motor_control.c **** #define RB_PIN   GPIO_PIN_11     /* D7  pinRB */
  18:Src/motor_control.c **** #define RF_PORT  GPIOD
  19:Src/motor_control.c **** #define RF_PIN   GPIO_PIN_12     /* D8  pinRF */
  20:Src/motor_control.c **** 
  21:Src/motor_control.c **** /* ---- PWM speed outputs on TIM1 complementary channels -------------------- */
  22:Src/motor_control.c **** #define LPWM_CH  TIM_CHANNEL_4   /* D6 PD5  -> TIM1_CH4N (left  speed) */
  23:Src/motor_control.c **** #define RPWM_CH  TIM_CHANNEL_2   /* D5 PE10 -> TIM1_CH2N (right speed) */
  24:Src/motor_control.c **** 
ARM GAS  /tmp/claude-1000/ccBLwmT9.s 			page 2


  25:Src/motor_control.c **** /* PWM: ARR=255 so a 0..255 command maps directly to duty (like analogWrite).
  26:Src/motor_control.c ****  * Higher PWM frequency (~5 kHz here vs the old ~1 kHz) smooths the current
  27:Src/motor_control.c ****  * through the motor inductance, so LOW duty runs steadier instead of cogging/
  28:Src/motor_control.c ****  * stuttering -- that's what lets us cruise slower without ruckeln. (L298N is a
  29:Src/motor_control.c ****  * slow BJT bridge; keep this <= ~10 kHz.) Lower MOTOR_PWM_PSC = higher freq. */
  30:Src/motor_control.c **** #define MOTOR_PWM_ARR   255u
  31:Src/motor_control.c **** #define MOTOR_PWM_PSC   155u
  32:Src/motor_control.c **** 
  33:Src/motor_control.c **** /* Cruise speeds (0..255 duty). Tuning knobs: 220 was smooth but too fast, 110
  34:Src/motor_control.c ****  * stuttered. 150 + the higher PWM freq above aims for "slow but smooth". If it
  35:Src/motor_control.c ****  * still ruckelt, the L298N's voltage drop is the floor -> raise toward ~180 (the
  36:Src/motor_control.c ****  * slowest still-smooth value) or switch to a MOSFET driver (TB6612/DRV8833).
  37:Src/motor_control.c ****  * CURVE_SLOW = inner wheel in a turn. */
  38:Src/motor_control.c **** #define MOTOR_FWD_SPEED    150
  39:Src/motor_control.c **** #define MOTOR_BWD_SPEED    150
  40:Src/motor_control.c **** #define MOTOR_CURVE_FAST   150
  41:Src/motor_control.c **** #define MOTOR_CURVE_SLOW   100
  42:Src/motor_control.c **** 
  43:Src/motor_control.c **** static TIM_HandleTypeDef htim1;
  44:Src/motor_control.c **** 
  45:Src/motor_control.c **** static int clamp_speed(int v)
  46:Src/motor_control.c **** {
  47:Src/motor_control.c ****   if (v < 0)   return 0;
  48:Src/motor_control.c ****   if (v > 255) return 255;
  49:Src/motor_control.c ****   return v;
  50:Src/motor_control.c **** }
  51:Src/motor_control.c **** 
