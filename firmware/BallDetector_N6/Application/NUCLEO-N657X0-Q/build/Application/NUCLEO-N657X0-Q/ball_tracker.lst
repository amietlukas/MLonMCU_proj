   1:Src/ball_tracker.c **** /**
   2:Src/ball_tracker.c ****  ******************************************************************************
   3:Src/ball_tracker.c ****  * @file    ball_tracker.c
   4:Src/ball_tracker.c ****  * @brief   1-D ball tracker + 50 Hz servo control (see ball_tracker.h).
   5:Src/ball_tracker.c ****  ******************************************************************************
   6:Src/ball_tracker.c ****  */
   7:Src/ball_tracker.c **** #include "main.h"
   8:Src/ball_tracker.c **** #include "ball_tracker.h"
   9:Src/ball_tracker.c **** #include "servo_control.h"
  10:Src/ball_tracker.c **** 
  11:Src/ball_tracker.c **** /* Control runs in the TIM7 ISR. We integrate with MEASURED elapsed time (not a
  12:Src/ball_tracker.c ****  * fixed period) so the servo moves the correct amount whatever the actual ISR
  13:Src/ball_tracker.c ****  * rate turns out to be (the NPU inference can starve the timer). */
  14:Src/ball_tracker.c **** #define TICK_TARGET_HZ   50.0f
  15:Src/ball_tracker.c **** 
  16:Src/ball_tracker.c **** /* ---- alpha-beta filter gains (position / velocity correction) ------------ *
  17:Src/ball_tracker.c ****  * Control rate == detection rate (~12 Hz, inference-bound), so prediction buys
  18:Src/ball_tracker.c ****  * nothing and adds noise -> BETA=0 disables velocity, leaving a clean smoothed
  19:Src/ball_tracker.c ****  * proportional controller (robust, like the original) plus the lifecycle. */
  20:Src/ball_tracker.c **** #define TRK_ALPHA        0.25f
  21:Src/ball_tracker.c **** #define TRK_BETA         0.0f
  22:Src/ball_tracker.c **** 
  23:Src/ball_tracker.c **** /* ---- control law (pan rate from position error + velocity feedforward) --- */
  24:Src/ball_tracker.c **** #define TRK_SIGN         (-1.0f)   /* pan direction toward ball (verified)      */
  25:Src/ball_tracker.c **** #define TRK_KP           60.0f     /* deg/s per unit of error                   */
ARM GAS  /tmp/claude-1000/cctNtDeN.s 			page 2


  26:Src/ball_tracker.c **** #define TRK_KV           0.0f      /* velocity feedforward off (tune later)     */
  27:Src/ball_tracker.c **** #define TRK_OMEGA_MAX    95.0f     /* max pan rate (matches the faster SIMPLE path) */
  28:Src/ball_tracker.c **** #define TRK_DEADZONE     0.05f     /* |x-0.5| below this = centered, no pan      */
  29:Src/ball_tracker.c **** #define TRK_COAST_TAU    0.5f      /* coast pan-rate decay time constant (s)     */
  30:Src/ball_tracker.c **** 
  31:Src/ball_tracker.c **** /* ---- lifecycle ----------------------------------------------------------- */
  32:Src/ball_tracker.c **** #define TRK_CONFIRM      3          /* consecutive hits to confirm a track       */
  33:Src/ball_tracker.c **** #define TRK_COAST_START  0.20f      /* s without a hit -> start coasting         */
  34:Src/ball_tracker.c **** #define TRK_COAST_MAX    0.50f      /* s coasting -> declare lost, hold          */
  35:Src/ball_tracker.c **** #define TRK_COAST_DECAY  0.96f      /* per-tick pan-rate decay while coasting     */
  36:Src/ball_tracker.c **** 
  37:Src/ball_tracker.c **** /* Tracker state -- written ONLY by BallTracker_ControlTick (main-loop context). */
  38:Src/ball_tracker.c **** static volatile float    g_x     = 0.5f;   /* filtered horizontal position */
  39:Src/ball_tracker.c **** static volatile float    g_v     = 0.0f;   /* velocity (units/s)           */
  40:Src/ball_tracker.c **** static volatile int      g_state = TRK_IDLE;
  41:Src/ball_tracker.c **** static float    g_omega = 0.0f;            /* current pan rate (deg/s)     */
  42:Src/ball_tracker.c **** static float    g_theta = 90.0f;           /* servo angle the tracker owns */
  43:Src/ball_tracker.c **** static int      g_hits  = 0;
  44:Src/ball_tracker.c **** static float    g_age   = 0.0f;            /* s since last associated hit  */
  45:Src/ball_tracker.c **** static uint32_t g_ticks = 0;
  46:Src/ball_tracker.c **** 
  47:Src/ball_tracker.c **** /* Mailbox: main loop -> ISR. seq incremented last so the ISR sees a coherent
  48:Src/ball_tracker.c ****  * (present, x) once it observes a new seq. */
  49:Src/ball_tracker.c **** static volatile float    g_mbx_x       = 0.5f;
  50:Src/ball_tracker.c **** static volatile uint8_t  g_mbx_present = 0;
  51:Src/ball_tracker.c **** static volatile uint32_t g_mbx_seq     = 0;
  52:Src/ball_tracker.c **** static uint32_t          g_last_seq    = 0;
  53:Src/ball_tracker.c **** 
  54:Src/ball_tracker.c **** float    BallTracker_GetX(void)      { return g_x; }
