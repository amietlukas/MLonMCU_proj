  66:Src/ball_tracker.c **** /* Apply one detection-frame result to the filter + lifecycle (ISR context). */
  67:Src/ball_tracker.c **** static void tracker_apply_measurement(int present, float mx)
  68:Src/ball_tracker.c **** {
  69:Src/ball_tracker.c ****   if (present) {
  70:Src/ball_tracker.c ****     if (g_state == TRK_IDLE) {                 /* seed a tentative track */
  71:Src/ball_tracker.c ****       g_x = mx; g_v = 0.0f; g_hits = 1; g_age = 0.0f;
  72:Src/ball_tracker.c ****       g_state = TRK_TENTATIVE;
  73:Src/ball_tracker.c ****       g_theta = (float)Servo_GetAngle();       /* resync to actual servo angle */
  74:Src/ball_tracker.c ****       return;
  75:Src/ball_tracker.c ****     }
  76:Src/ball_tracker.c ****     /* alpha-beta correction (dt = time since last hit, clamped). */
  77:Src/ball_tracker.c ****     float dtm = g_age; if (dtm < 0.005f) dtm = 0.005f; if (dtm > 0.5f) dtm = 0.5f;
  78:Src/ball_tracker.c ****     float r = mx - g_x;
  79:Src/ball_tracker.c ****     g_x += TRK_ALPHA * r;
  80:Src/ball_tracker.c ****     g_v += (TRK_BETA / dtm) * r;
  81:Src/ball_tracker.c ****     g_age = 0.0f;
  82:Src/ball_tracker.c ****     if (g_hits < TRK_CONFIRM) g_hits++;
  83:Src/ball_tracker.c ****     if (g_state == TRK_TENTATIVE && g_hits >= TRK_CONFIRM) g_state = TRK_CONFIRMED;
  84:Src/ball_tracker.c ****     if (g_state == TRK_COAST) g_state = TRK_CONFIRMED;   /* re-acquired */
  85:Src/ball_tracker.c ****   } else {
  86:Src/ball_tracker.c ****     /* miss: a tentative track needs consecutive hits, so drop it; a confirmed
  87:Src/ball_tracker.c ****      * track is handled by the coast timeout (age keeps growing below). */
  88:Src/ball_tracker.c ****     if (g_state == TRK_TENTATIVE) { g_state = TRK_IDLE; g_hits = 0; g_v = 0.0f; }
  89:Src/ball_tracker.c ****   }
  90:Src/ball_tracker.c **** }
