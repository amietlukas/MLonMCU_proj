 155:../../Middlewares/screenl/Src/scrl_common.c **** static int32_t SPI_FillRGBRectBpp3(uint32_t Instance, uint32_t Xpos, uint32_t Ypos, uint8_t *pData,
 156:../../Middlewares/screenl/Src/scrl_common.c ****                                    uint32_t Height)
 157:../../Middlewares/screenl/Src/scrl_common.c **** {
 158:../../Middlewares/screenl/Src/scrl_common.c ****   struct scrl_common_ctx *ctx = (struct scrl_common_ctx *) Instance;
 159:../../Middlewares/screenl/Src/scrl_common.c ****   int layer_width;
 160:../../Middlewares/screenl/Src/scrl_common.c ****   uint8_t *pel;
 161:../../Middlewares/screenl/Src/scrl_common.c ****   int w, h;
 162:../../Middlewares/screenl/Src/scrl_common.c **** 
 163:../../Middlewares/screenl/Src/scrl_common.c ****   assert(ctx);
 164:../../Middlewares/screenl/Src/scrl_common.c **** 
 165:../../Middlewares/screenl/Src/scrl_common.c ****   layer_width = ctx->layers[ctx->layer].size.width;
 166:../../Middlewares/screenl/Src/scrl_common.c ****   pel = ctx->layers[ctx->layer].address;
 167:../../Middlewares/screenl/Src/scrl_common.c ****   pel += (Ypos * layer_width * 3) + Xpos * 3;
 168:../../Middlewares/screenl/Src/scrl_common.c ****   for (h = 0; h < Height; h++) {
 169:../../Middlewares/screenl/Src/scrl_common.c ****     for (w = 0; w < Width; w++) {
 170:../../Middlewares/screenl/Src/scrl_common.c ****       pel[3 * w + 0] = *pData++;
 171:../../Middlewares/screenl/Src/scrl_common.c ****       pel[3 * w + 1] = *pData++;
 172:../../Middlewares/screenl/Src/scrl_common.c ****       pel[3 * w + 2] = *pData++;
 173:../../Middlewares/screenl/Src/scrl_common.c ****     }
 174:../../Middlewares/screenl/Src/scrl_common.c ****     pel += layer_width + 3;
 175:../../Middlewares/screenl/Src/scrl_common.c ****   }
 176:../../Middlewares/screenl/Src/scrl_common.c **** 
 177:../../Middlewares/screenl/Src/scrl_common.c ****   return 0;
 178:../../Middlewares/screenl/Src/scrl_common.c **** }
