  46:../../Middlewares/screenl/Src/scrl_common.c **** static int32_t SPI_FillRGBRectBpp2(uint32_t Instance, uint32_t Xpos, uint32_t Ypos, uint8_t *pData,
  47:../../Middlewares/screenl/Src/scrl_common.c ****                                    uint32_t Height)
  48:../../Middlewares/screenl/Src/scrl_common.c **** {
  49:../../Middlewares/screenl/Src/scrl_common.c ****   struct scrl_common_ctx *ctx = (struct scrl_common_ctx *) Instance;
  50:../../Middlewares/screenl/Src/scrl_common.c ****   int layer_width;
  51:../../Middlewares/screenl/Src/scrl_common.c ****   uint16_t *pel;
  52:../../Middlewares/screenl/Src/scrl_common.c ****   int w, h;
  53:../../Middlewares/screenl/Src/scrl_common.c **** 
  54:../../Middlewares/screenl/Src/scrl_common.c ****   assert(ctx);
  55:../../Middlewares/screenl/Src/scrl_common.c **** 
  56:../../Middlewares/screenl/Src/scrl_common.c ****   layer_width = ctx->layers[ctx->layer].size.width;
  57:../../Middlewares/screenl/Src/scrl_common.c ****   pel = (uint16_t *) ctx->layers[ctx->layer].address;
  58:../../Middlewares/screenl/Src/scrl_common.c ****   pel += (Ypos * layer_width) + Xpos;
  59:../../Middlewares/screenl/Src/scrl_common.c ****   for (h = 0; h < Height; h++) {
  60:../../Middlewares/screenl/Src/scrl_common.c ****     for (w = 0; w < Width; w++) {
  61:../../Middlewares/screenl/Src/scrl_common.c ****       pel[w] = *(uint16_t *)pData;
  62:../../Middlewares/screenl/Src/scrl_common.c ****       pData += 2;
  63:../../Middlewares/screenl/Src/scrl_common.c ****     }
  64:../../Middlewares/screenl/Src/scrl_common.c ****     pel += layer_width;
  65:../../Middlewares/screenl/Src/scrl_common.c ****   }
  66:../../Middlewares/screenl/Src/scrl_common.c **** 
  67:../../Middlewares/screenl/Src/scrl_common.c ****   return 0;
  68:../../Middlewares/screenl/Src/scrl_common.c **** }
