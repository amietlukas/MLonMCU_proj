  57:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** 
  58:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** #define AI_STORAGE_KLASS_COPY(dst_, dst_type_, src_, src_type_) \
  59:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** { \
  60:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   AI_ASSERT(AI_STORAGE_KLASS_SIZE(src_)>=AI_STORAGE_KLASS_SIZE(dst_)) \
