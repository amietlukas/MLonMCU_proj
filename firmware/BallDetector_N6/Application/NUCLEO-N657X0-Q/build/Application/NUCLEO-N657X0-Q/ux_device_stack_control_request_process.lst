 240:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                         if ((request_index & 0xFF) != class_index)
 241:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                             continue;
