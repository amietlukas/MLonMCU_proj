 224:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                     /* For printer class (0x07) GET_DEVICE_ID (0x00) the high byte of 
 225:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                        wIndex is interface index (for recommended index sequence the interface
 226:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                        number is same as interface index inside configuration).
 227:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                      */
 228:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                     if ((request_type == 0xA1) && (request == 0x00) &&
 229:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                         (class_ptr -> ux_slave_class_interface -> ux_slave_interface_descriptor.bIn
 230:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                     {
 231:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c **** 
 232:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                         /* Check wIndex high byte.  */
 233:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                         if(*(transfer_request -> ux_slave_transfer_request_setup + UX_SETUP_INDEX +
 234:../../STM32Cube_FW_N6/Middlewares/ST/usbx/common/core/src/ux_device_stack_control_request_process.c ****                             continue;
