  65:Src/yolo_postproc.c ****     conf_thresh = clampf(conf_thresh, 1e-4f, 0.9999f);
  66:Src/yolo_postproc.c **** 
  67:Src/yolo_postproc.c ****     yolo_box_t cand[PRENMS_CAP];
  68:Src/yolo_postproc.c ****     int n_cand = 0;
  69:Src/yolo_postproc.c **** 
  70:Src/yolo_postproc.c ****     const float logit_thr = logitf(conf_thresh);
  71:Src/yolo_postproc.c **** 
  72:Src/yolo_postproc.c ****     for (int h = 0; h < n_heads; ++h) {
  73:Src/yolo_postproc.c ****         const uint8_t *buf = heads[h];
  74:Src/yolo_postproc.c ****         if (!buf) continue;
  75:Src/yolo_postproc.c **** 
  76:Src/yolo_postproc.c ****         const int H = grid_h[h];
  77:Src/yolo_postproc.c ****         const int W = grid_w[h];
  78:Src/yolo_postproc.c ****         const int HW = H * W;
ARM GAS  /tmp/claude-1000/ccSL2OR7.s 			page 4


  79:Src/yolo_postproc.c ****         const float scale = scales[h];          /* per-head, from generated macros */
  80:Src/yolo_postproc.c ****         const int   zp    = zps[h];
  81:Src/yolo_postproc.c ****         const float stride = (float)strides[h];
  82:Src/yolo_postproc.c **** 
  83:Src/yolo_postproc.c ****         /* The NPU outputs are SIGNED int8 (QLinear int8). They MUST be read as
  84:Src/yolo_postproc.c ****          * int8_t: reading as uint8 turns a negative logit (e.g. -2 = 0xFE) into
  85:Src/yolo_postproc.c ****          * +254, which dequantizes to a huge value and saturates sigmoid to 1.0.
  86:Src/yolo_postproc.c ****          * That was the "8 boxes @ score=1.000 on every frame" bug — worst on the
  87:Src/yolo_postproc.c ****          * zero_point=0 heads (p16/p32), where most objectness logits are negative. */
  88:Src/yolo_postproc.c ****         /* Objectness threshold (signed): q >= q_thr iff tobj_float >= logit_thr,
  89:Src/yolo_postproc.c ****          * tobj_float = (q - zp) * scale  =>  q = zp + logit_thr / scale. */
  90:Src/yolo_postproc.c ****         const float q_thr_f = (float)zp + logit_thr / scale;
  91:Src/yolo_postproc.c ****         int q_thr;
  92:Src/yolo_postproc.c ****         if      (q_thr_f <= -128.0f)  q_thr = -128;
  93:Src/yolo_postproc.c ****         else if (q_thr_f >=  127.0f)  q_thr =  128;   /* never matches */
  94:Src/yolo_postproc.c ****         else                          q_thr = (int)ceilf(q_thr_f);
  95:Src/yolo_postproc.c **** 
  96:Src/yolo_postproc.c ****         const int8_t *p_tobj = (const int8_t *)buf + 4 * HW;
  97:Src/yolo_postproc.c ****         const int8_t *p_tx   = (const int8_t *)buf + 0 * HW;
  98:Src/yolo_postproc.c ****         const int8_t *p_ty   = (const int8_t *)buf + 1 * HW;
  99:Src/yolo_postproc.c ****         const int8_t *p_tw   = (const int8_t *)buf + 2 * HW;
 100:Src/yolo_postproc.c ****         const int8_t *p_th   = (const int8_t *)buf + 3 * HW;
 101:Src/yolo_postproc.c **** 
 102:Src/yolo_postproc.c ****         for (int y = 0; y < H; ++y) {
 103:Src/yolo_postproc.c ****             for (int x = 0; x < W; ++x) {
 104:Src/yolo_postproc.c ****                 const int idx = y * W + x;
 105:Src/yolo_postproc.c ****                 const int q = p_tobj[idx];          /* signed int8 objectness */
 106:Src/yolo_postproc.c ****                 if (q < q_thr) continue;
 107:Src/yolo_postproc.c **** 
 108:Src/yolo_postproc.c ****                 const float tx = ((float)p_tx[idx] - zp) * scale;
 109:Src/yolo_postproc.c ****                 const float ty = ((float)p_ty[idx] - zp) * scale;
 110:Src/yolo_postproc.c ****                 const float tw = ((float)p_tw[idx] - zp) * scale;
 111:Src/yolo_postproc.c ****                 const float th = ((float)p_th[idx] - zp) * scale;
 112:Src/yolo_postproc.c ****                 const float to = ((float)q        - zp) * scale;
 113:Src/yolo_postproc.c **** 
 114:Src/yolo_postproc.c ****                 const float cx = (sigmoidf(tx) + (float)x) * stride;
 115:Src/yolo_postproc.c ****                 const float cy = (sigmoidf(ty) + (float)y) * stride;
 116:Src/yolo_postproc.c ****                 const float pw = expf(clampf(tw, TWTH_CLAMP_MIN, TWTH_CLAMP_MAX)) * stride;
 117:Src/yolo_postproc.c ****                 const float ph = expf(clampf(th, TWTH_CLAMP_MIN, TWTH_CLAMP_MAX)) * stride;
 118:Src/yolo_postproc.c **** 
 119:Src/yolo_postproc.c ****                 yolo_box_t b;
 120:Src/yolo_postproc.c ****                 b.x1 = clampf(cx - 0.5f * pw, 0.0f, (float)YOLO_INPUT_W);
 121:Src/yolo_postproc.c ****                 b.y1 = clampf(cy - 0.5f * ph, 0.0f, (float)YOLO_INPUT_H);
 122:Src/yolo_postproc.c ****                 b.x2 = clampf(cx + 0.5f * pw, 0.0f, (float)YOLO_INPUT_W);
 123:Src/yolo_postproc.c ****                 b.y2 = clampf(cy + 0.5f * ph, 0.0f, (float)YOLO_INPUT_H);
 124:Src/yolo_postproc.c ****                 b.score = sigmoidf(to);
 125:Src/yolo_postproc.c **** 
 126:Src/yolo_postproc.c ****                 if (n_cand < PRENMS_CAP) {
 127:Src/yolo_postproc.c ****                     cand[n_cand++] = b;
 128:Src/yolo_postproc.c ****                 } else {
 129:Src/yolo_postproc.c ****                     /* Buffer full — evict the lowest-scoring entry if this one is better.
 130:Src/yolo_postproc.c ****                      * Linear scan is fine; PRENMS_CAP is small. */
 131:Src/yolo_postproc.c ****                     int worst = 0;
 132:Src/yolo_postproc.c ****                     for (int k = 1; k < PRENMS_CAP; ++k) {
 133:Src/yolo_postproc.c ****                         if (cand[k].score < cand[worst].score) worst = k;
 134:Src/yolo_postproc.c ****                     }
 135:Src/yolo_postproc.c ****                     if (b.score > cand[worst].score) cand[worst] = b;
ARM GAS  /tmp/claude-1000/ccSL2OR7.s 			page 5


 136:Src/yolo_postproc.c ****                 }
 137:Src/yolo_postproc.c ****             }
 138:Src/yolo_postproc.c ****         }
 139:Src/yolo_postproc.c ****     }
 140:Src/yolo_postproc.c **** 
 141:Src/yolo_postproc.c ****     if (n_cand == 0) return 0;
 142:Src/yolo_postproc.c **** 
 143:Src/yolo_postproc.c ****     /* Sort candidates by score desc (insertion sort, small n). */
 144:Src/yolo_postproc.c ****     for (int i = 1; i < n_cand; ++i) {
 145:Src/yolo_postproc.c ****         yolo_box_t key = cand[i];
 146:Src/yolo_postproc.c ****         int j = i - 1;
 147:Src/yolo_postproc.c ****         while (j >= 0 && cand[j].score < key.score) {
 148:Src/yolo_postproc.c ****             cand[j + 1] = cand[j];
 149:Src/yolo_postproc.c ****             --j;
 150:Src/yolo_postproc.c ****         }
 151:Src/yolo_postproc.c ****         cand[j + 1] = key;
 152:Src/yolo_postproc.c ****     }
 153:Src/yolo_postproc.c **** 
 154:Src/yolo_postproc.c ****     /* Greedy NMS. */
 155:Src/yolo_postproc.c ****     uint8_t suppressed[PRENMS_CAP] = {0};
 156:Src/yolo_postproc.c ****     int n_out = 0;
 157:Src/yolo_postproc.c ****     for (int i = 0; i < n_cand && n_out < out_cap; ++i) {
 158:Src/yolo_postproc.c ****         if (suppressed[i]) continue;
 159:Src/yolo_postproc.c ****         const yolo_box_t *bi = &cand[i];
 160:Src/yolo_postproc.c ****         out[n_out++] = *bi;
 161:Src/yolo_postproc.c ****         const float ai = (bi->x2 - bi->x1) * (bi->y2 - bi->y1);
 162:Src/yolo_postproc.c ****         for (int j = i + 1; j < n_cand; ++j) {
 163:Src/yolo_postproc.c ****             if (suppressed[j]) continue;
 164:Src/yolo_postproc.c ****             const yolo_box_t *bj = &cand[j];
 165:Src/yolo_postproc.c ****             const float xx1 = bi->x1 > bj->x1 ? bi->x1 : bj->x1;
 166:Src/yolo_postproc.c ****             const float yy1 = bi->y1 > bj->y1 ? bi->y1 : bj->y1;
 167:Src/yolo_postproc.c ****             const float xx2 = bi->x2 < bj->x2 ? bi->x2 : bj->x2;
 168:Src/yolo_postproc.c ****             const float yy2 = bi->y2 < bj->y2 ? bi->y2 : bj->y2;
 169:Src/yolo_postproc.c ****             const float iw = xx2 - xx1; if (iw <= 0.0f) continue;
 170:Src/yolo_postproc.c ****             const float ih = yy2 - yy1; if (ih <= 0.0f) continue;
 171:Src/yolo_postproc.c ****             const float inter = iw * ih;
 172:Src/yolo_postproc.c ****             const float aj = (bj->x2 - bj->x1) * (bj->y2 - bj->y1);
 173:Src/yolo_postproc.c ****             const float uni = ai + aj - inter;
 174:Src/yolo_postproc.c ****             if (uni > 0.0f && (inter / uni) >= iou_thresh) suppressed[j] = 1;
 175:Src/yolo_postproc.c ****         }
 176:Src/yolo_postproc.c ****     }
 177:Src/yolo_postproc.c ****     return n_out;
 178:Src/yolo_postproc.c **** }
