   1:Src/yolo_postproc.c **** /* Implementation — see yolo_postproc.h.
   2:Src/yolo_postproc.c ****  *
   3:Src/yolo_postproc.c ****  * Hot path:
   4:Src/yolo_postproc.c ****  *   1. For each head and cell, reject early using a *quantized* threshold
   5:Src/yolo_postproc.c ****  *      on tobj (no math, no dequant). Survivors are typically a few hundred
   6:Src/yolo_postproc.c ****  *      out of 6300 cells.
   7:Src/yolo_postproc.c ****  *   2. For survivors, dequant + sigmoid/exp decode → xyxy.
   8:Src/yolo_postproc.c ****  *   3. Bubble-sort top-K by score (K small, ~32), then greedy NMS.
   9:Src/yolo_postproc.c ****  *
  10:Src/yolo_postproc.c ****  * Quant params come from stedgeai's analyze report and are fixed for this
  11:Src/yolo_postproc.c ****  * model. If the model is re-trained or re-quantized, re-run
  12:Src/yolo_postproc.c ****  * `stedgeai analyze` and update these constants.
  13:Src/yolo_postproc.c ****  */
  14:Src/yolo_postproc.c **** #include "yolo_postproc.h"
  15:Src/yolo_postproc.c **** 
  16:Src/yolo_postproc.c **** #include <math.h>
  17:Src/yolo_postproc.c **** #include <string.h>
  18:Src/yolo_postproc.c **** 
  19:Src/yolo_postproc.c **** /* Per-head config (count/scale/zp/stride/grid) is now passed in at call time,
  20:Src/yolo_postproc.c ****  * sourced from the generated STAI_NETWORK_OUT_* macros -- see head_cfg_init()
  21:Src/yolo_postproc.c ****  * in main.c. Fully model-agnostic: 2- or 3-head, any stride set. */
  22:Src/yolo_postproc.c **** 
  23:Src/yolo_postproc.c **** /* Match the training-time decode clamp range. */
  24:Src/yolo_postproc.c **** #define TWTH_CLAMP_MIN  (-4.0f)
ARM GAS  /tmp/claude-1000/ccSL2OR7.s 			page 2


  25:Src/yolo_postproc.c **** #define TWTH_CLAMP_MAX  ( 4.0f)
  26:Src/yolo_postproc.c **** 
  27:Src/yolo_postproc.c **** /* Pre-NMS candidate cap. 6300 total cells; in practice <100 survive a 0.5
  28:Src/yolo_postproc.c ****  * objectness threshold even on busy scenes. 128 leaves headroom. */
  29:Src/yolo_postproc.c **** #define PRENMS_CAP  128
  30:Src/yolo_postproc.c **** 
  31:Src/yolo_postproc.c **** /* --- helpers -------------------------------------------------------------- */
  32:Src/yolo_postproc.c **** 
  33:Src/yolo_postproc.c **** static inline float sigmoidf(float x) {
  34:Src/yolo_postproc.c ****     return 1.0f / (1.0f + expf(-x));
  35:Src/yolo_postproc.c **** }
  36:Src/yolo_postproc.c **** 
  37:Src/yolo_postproc.c **** static inline float clampf(float v, float lo, float hi) {
  38:Src/yolo_postproc.c ****     return v < lo ? lo : (v > hi ? hi : v);
  39:Src/yolo_postproc.c **** }
  40:Src/yolo_postproc.c **** 
  41:Src/yolo_postproc.c **** /* logit(p) = ln(p/(1-p)) — inverse of sigmoid. Used to convert the
  42:Src/yolo_postproc.c ****  * post-sigmoid confidence threshold into a pre-sigmoid (and then
  43:Src/yolo_postproc.c ****  * quantized) threshold so the inner loop can reject cells with a single
  44:Src/yolo_postproc.c ****  * uint8 compare. */
  45:Src/yolo_postproc.c **** static inline float logitf(float p) {
  46:Src/yolo_postproc.c ****     return logf(p / (1.0f - p));
  47:Src/yolo_postproc.c **** }
  48:Src/yolo_postproc.c **** 
