 810:Src/main.c    ****           moved = 1;
 811:Src/main.c    ****         }
 812:Src/main.c    ****       } else {
 813:Src/main.c    ****         s_xfilt = 0.5f;                                                /* no ball -> hold servo */
 814:Src/main.c    ****         s_eprev = 0.0f;                                                /* no derivative kick on re-
 815:Src/main.c    ****       }
