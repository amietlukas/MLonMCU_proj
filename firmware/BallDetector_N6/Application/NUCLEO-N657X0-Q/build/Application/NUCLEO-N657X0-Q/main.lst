 250:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****   if (op2 == 0U)
 251:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****   {
 252:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****     return op1;
