 349:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE int32_t __SSAT(int32_t val, uint32_t sat)
 350:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h **** {
