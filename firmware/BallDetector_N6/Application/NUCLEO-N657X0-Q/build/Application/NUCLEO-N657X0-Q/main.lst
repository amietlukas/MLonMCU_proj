1368:Src/main.c    **** /* HC-06 Bluetooth module: transparent serial bridge (same role as Serial in
1369:Src/main.c    ****  * paul_car.ino). It sits on the Arduino D0/D1 header pins = USART3 (PD9 RX,
1370:Src/main.c    ****  * PD8 TX). HC-06 default baud is 9600. Received bytes are drive commands. */
1371:Src/main.c    **** static void BT_Config(void)
1372:Src/main.c    **** {
1373:Src/main.c    ****   GPIO_InitTypeDef gpio_init = {0};
1374:Src/main.c    **** 
1375:Src/main.c    ****   __HAL_RCC_USART3_CLK_ENABLE();
1376:Src/main.c    ****   __HAL_RCC_GPIOD_CLK_ENABLE();
1377:Src/main.c    **** 
1378:Src/main.c    ****   gpio_init.Mode      = GPIO_MODE_AF_PP;
1379:Src/main.c    ****   gpio_init.Pull      = GPIO_PULLUP;
1380:Src/main.c    ****   gpio_init.Speed     = GPIO_SPEED_FREQ_HIGH;
1381:Src/main.c    ****   gpio_init.Pin       = GPIO_PIN_8 | GPIO_PIN_9;   /* PD8 USART3_TX, PD9 USART3_RX */
1382:Src/main.c    ****   gpio_init.Alternate = GPIO_AF7_USART3;
1383:Src/main.c    ****   HAL_GPIO_Init(GPIOD, &gpio_init);
1384:Src/main.c    **** 
1385:Src/main.c    ****   huart3.Instance          = USART3;
1386:Src/main.c    ****   huart3.Init.BaudRate     = 9600;                 /* HC-06 default */
1387:Src/main.c    ****   huart3.Init.Mode         = UART_MODE_TX_RX;
1388:Src/main.c    ****   huart3.Init.Parity       = UART_PARITY_NONE;
1389:Src/main.c    ****   huart3.Init.WordLength   = UART_WORDLENGTH_8B;
1390:Src/main.c    ****   huart3.Init.StopBits     = UART_STOPBITS_1;
1391:Src/main.c    ****   huart3.Init.HwFlowCtl    = UART_HWCONTROL_NONE;
1392:Src/main.c    ****   huart3.Init.OverSampling = UART_OVERSAMPLING_16;
1393:Src/main.c    ****   if (HAL_UART_Init(&huart3) != HAL_OK)
1394:Src/main.c    ****   {
1395:Src/main.c    ****     while (1);
1396:Src/main.c    ****   }
1397:Src/main.c    **** 
1398:Src/main.c    ****   /* Enable the 8-byte RX FIFO. The CPU is busy in NPU inference ~70ms of every
1399:Src/main.c    ****    * ~80ms loop and can't service this ISR meanwhile; with only the 1-byte RDR a
1400:Src/main.c    ****    * command burst overruns and all but the last byte is lost (the "Arduino was
1401:Src/main.c    ****    * better" symptom -- the Arduino is never blocked). The FIFO buffers a whole
1402:Src/main.c    ****    * short burst in hardware through that window; the ISR drains it all at once
1403:Src/main.c    ****    * once the CPU is free (see the while-loop in USART3_IRQHandler). */
1404:Src/main.c    ****   HAL_UARTEx_SetRxFifoThreshold(&huart3, UART_RXFIFO_THRESHOLD_1_8);
1405:Src/main.c    ****   HAL_UARTEx_EnableFifoMode(&huart3);
1406:Src/main.c    **** 
1407:Src/main.c    ****   /* Interrupt-driven RX (see USART3_IRQHandler / ring buffer). */
1408:Src/main.c    ****   HAL_NVIC_SetPriority(USART3_IRQn, 6, 0);
1409:Src/main.c    ****   HAL_NVIC_EnableIRQ(USART3_IRQn);
1410:Src/main.c    ****   __HAL_UART_ENABLE_IT(&huart3, UART_IT_RXNE);
1411:Src/main.c    **** }
