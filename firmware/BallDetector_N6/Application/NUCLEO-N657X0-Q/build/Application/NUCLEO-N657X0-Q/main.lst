 243:Src/main.c    **** /* ---- HC-06 Bluetooth RX: interrupt-driven ring buffer -------------------- *
 244:Src/main.c    ****  * Polling USART3 once per (slow, NN-bound) loop iteration dropped bytes and
 245:Src/main.c    ****  * latched on overrun -> commands flaky / receiver stuck. Instead receive in the
 246:Src/main.c    ****  * USART3 ISR into a ring buffer and let the loop drain it, decoupled from the
 247:Src/main.c    ****  * loop period. ORE is cleared so a single overrun never wedges reception. */
 248:Src/main.c    **** #define BT_RING_SZ 64u
 249:Src/main.c    **** /* Each event carries the received byte plus how many CPU cycles the in-ISR
 250:Src/main.c    ****  * motor/servo activation took (receive -> CCR/GPIO written). The loop prints it. */
 251:Src/main.c    **** typedef struct { uint8_t b; uint32_t act_cyc; } bt_evt_t;
 252:Src/main.c    **** static volatile bt_evt_t bt_ring[BT_RING_SZ];
 253:Src/main.c    **** static volatile uint16_t bt_head = 0, bt_tail = 0;
 254:Src/main.c    **** 
 255:Src/main.c    **** /* Pop one event; returns 1 and fills *evt, or 0 if the ring is empty. */
 256:Src/main.c    **** static int bt_ring_pop(bt_evt_t *evt)
 257:Src/main.c    **** {
 258:Src/main.c    ****   if (bt_tail == bt_head) return 0;
 259:Src/main.c    ****   *evt = bt_ring[bt_tail];
 260:Src/main.c    ****   bt_tail = (uint16_t)((bt_tail + 1u) % BT_RING_SZ);
 261:Src/main.c    ****   return 1;
 262:Src/main.c    **** }
 263:Src/main.c    **** 
 264:Src/main.c    **** /* Execute a Bluetooth command IMMEDIATELY in ISR context. Motor_Command and
 265:Src/main.c    ****  * Servo_Command are pure register writes (CCR/GPIO, no blocking, no HAL_Delay),
 266:Src/main.c    ****  * so they are ISR-safe and run the instant the byte arrives -- even during the
 267:Src/main.c    ****  * ~70 ms NPU inference, because __WFE wakes the CPU for this IRQ. That removes
 268:Src/main.c    ****  * the up-to-one-loop (~80 ms) latency of servicing commands from the main loop;
 269:Src/main.c    ****  * the loop now only echoes the bytes to the console. */
 270:Src/main.c    **** static void bt_dispatch(uint8_t b)
 271:Src/main.c    **** {
 272:Src/main.c    ****   if (b >= '0' && b <= '5') Motor_Command((char)b);
 273:Src/main.c    **** #if !SERVO_HOLD_TEST
 274:Src/main.c    ****   else if (b=='L'||b=='l'||b=='R'||b=='r'||b=='M'||b=='m'||b=='<'||b=='>') Servo_Command((char)b);
 275:Src/main.c    **** #endif
 276:Src/main.c    **** }
 277:Src/main.c    **** 
 278:Src/main.c    **** void USART3_IRQHandler(void)
 279:Src/main.c    **** {
 280:Src/main.c    ****   /* Drain the ENTIRE RX FIFO each entry: after the ~70ms inference window the
 281:Src/main.c    ****    * FIFO may hold several queued bytes; reading only one would leave the rest
 282:Src/main.c    ****    * (and eventually overrun). Loop while the FIFO is non-empty. */
 283:Src/main.c    ****   while (__HAL_UART_GET_FLAG(&huart3, UART_FLAG_RXNE)) {
 284:Src/main.c    ****     uint8_t b = (uint8_t)(huart3.Instance->RDR & 0xFFu);   /* pops one FIFO entry */
ARM GAS  /tmp/claude-1000/cchyGQCn.s 			page 45


 285:Src/main.c    ****     uint32_t t0 = DWT->CYCCNT;
 286:Src/main.c    ****     bt_dispatch(b);                                        /* act now */
 287:Src/main.c    ****     uint32_t act_cyc = DWT->CYCCNT - t0;                   /* receive -> motor/servo set */
 288:Src/main.c    ****     uint16_t nh = (uint16_t)((bt_head + 1u) % BT_RING_SZ);
 289:Src/main.c    ****     if (nh != bt_tail) {                                   /* queue for console print */
 290:Src/main.c    ****       bt_ring[bt_head].b = b; bt_ring[bt_head].act_cyc = act_cyc; bt_head = nh;
 291:Src/main.c    ****     }
 292:Src/main.c    ****   }
 293:Src/main.c    ****   if (__HAL_UART_GET_FLAG(&huart3, UART_FLAG_ORE)) {
 294:Src/main.c    ****     __HAL_UART_CLEAR_OREFLAG(&huart3);                    /* recover from overrun */
 295:Src/main.c    ****   }
 296:Src/main.c    **** }
 297:Src/main.c    **** 
 298:Src/main.c    **** /* Drain pending commands and echo every byte on UART1 (the console VCP) so the
 299:Src/main.c    ****  * actual received traffic is visible while debugging. */
 300:Src/main.c    **** static void process_commands(void)
 301:Src/main.c    **** {
 302:Src/main.c    ****   bt_evt_t e;
 303:Src/main.c    ****   while (bt_ring_pop(&e)) {
 304:Src/main.c    ****     /* Already executed in USART3_IRQHandler. Print byte + how long activation took. */
 305:Src/main.c    ****     char c = (e.b >= 32 && e.b < 127) ? (char)e.b : '.';
 306:Src/main.c    ****     int is_cmd = (e.b >= '0' && e.b <= '5') ||
 307:Src/main.c    ****                  e.b=='L'||e.b=='l'||e.b=='R'||e.b=='r'||e.b=='M'||e.b=='m'||e.b=='<'||e.b=='>';
 308:Src/main.c    ****     uint32_t cpus = SystemCoreClock / 1000000u; if (!cpus) cpus = 1u;
 309:Src/main.c    ****     uint32_t ns = (uint32_t)(((uint64_t)e.act_cyc * 1000u) / cpus);
 310:Src/main.c    ****     if (is_cmd)
 311:Src/main.c    ****       printf("BT rx '%c' (0x%02X) -> motor/servo set in %lu cyc (~%lu ns)\n",
 312:Src/main.c    ****              c, (unsigned)e.b, (unsigned long)e.act_cyc, (unsigned long)ns);
 313:Src/main.c    ****     else
 314:Src/main.c    ****       printf("BT rx '%c' (0x%02X) [no command]\n", c, (unsigned)e.b);
 315:Src/main.c    ****   }
 316:Src/main.c    ****   /* USB VCP: 'c' = frame dump; '0'-'5' = wired fallback drive command. */
 317:Src/main.c    ****   uint8_t t = 0;
 318:Src/main.c    ****   if (HAL_UART_Receive(&huart1, &t, 1, 0) == HAL_OK) {
 319:Src/main.c    ****     if (t == 'c' || t == 'C')          g_dump_req = 1;
 320:Src/main.c    ****     else if (t >= '0' && t <= '5') {   printf("VCP cmd '%c'\n", t); Motor_Command((char)t); }
 321:Src/main.c    ****   }
 322:Src/main.c    **** }
