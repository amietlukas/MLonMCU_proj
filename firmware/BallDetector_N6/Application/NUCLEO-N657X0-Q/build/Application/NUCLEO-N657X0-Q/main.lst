1034:Src/main.c    **** static void Display_Text90CW(uint32_t x, uint32_t y, const char *text)
1035:Src/main.c    **** {
1036:Src/main.c    ****   sFONT *font = UTIL_LCD_GetFont();
1037:Src/main.c    ****   const uint32_t fw = font->Width;
1038:Src/main.c    ****   const uint32_t fh = font->Height;
1039:Src/main.c    ****   const uint32_t bytes_per_row = (fw + 7u) / 8u;
1040:Src/main.c    ****   const uint32_t row_offset = (8u * bytes_per_row) - fw;
1041:Src/main.c    ****   const uint32_t color = UTIL_LCD_GetTextColor();
1042:Src/main.c    **** 
1043:Src/main.c    ****   for (uint32_t ci = 0; text[ci] != '\0'; ++ci) {
1044:Src/main.c    ****     uint8_t ch = (uint8_t)text[ci];
1045:Src/main.c    ****     if (ch < ' ' || ch > '~') ch = '?';
1046:Src/main.c    ****     const uint8_t *glyph = font->table + ((uint32_t)(ch - ' ') * fh * bytes_per_row);
1047:Src/main.c    **** 
1048:Src/main.c    ****     for (uint32_t row = 0; row < fh; ++row) {
1049:Src/main.c    ****       const uint8_t *p = glyph + (bytes_per_row * row);
1050:Src/main.c    ****       uint32_t bits;
1051:Src/main.c    ****       if (bytes_per_row == 1u) {
1052:Src/main.c    ****         bits = p[0];
1053:Src/main.c    ****       } else if (bytes_per_row == 2u) {
1054:Src/main.c    ****         bits = ((uint32_t)p[0] << 8) | p[1];
1055:Src/main.c    ****       } else {
1056:Src/main.c    ****         bits = ((uint32_t)p[0] << 16) | ((uint32_t)p[1] << 8) | p[2];
1057:Src/main.c    ****       }
1058:Src/main.c    **** 
1059:Src/main.c    ****       for (uint32_t col = 0; col < fw; ++col) {
1060:Src/main.c    ****         if ((bits & (1u << (fw - col + row_offset - 1u))) == 0u) continue;
1061:Src/main.c    ****         uint32_t dx = x + (fh - 1u - row);
1062:Src/main.c    ****         uint32_t dy = y + (ci * fw) + col;
1063:Src/main.c    ****         if (dx < lcd_fg_area.XSize && dy < lcd_fg_area.YSize) {
1064:Src/main.c    ****           UTIL_LCD_SetPixel((uint16_t)dx, (uint16_t)dy, color);
1065:Src/main.c    ****         }
1066:Src/main.c    ****       }
1067:Src/main.c    ****     }
1068:Src/main.c    ****   }
1069:Src/main.c    **** }
