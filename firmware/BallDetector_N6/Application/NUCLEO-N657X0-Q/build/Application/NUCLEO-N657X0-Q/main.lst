 380:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****     if (val > (int32_t)max)
 381:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h ****     {
