 247:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __ROR(uint32_t op1, uint32_t op2)
 248:../../STM32Cube_FW_N6/Drivers/CMSIS/Include/cmsis_gcc.h **** {
