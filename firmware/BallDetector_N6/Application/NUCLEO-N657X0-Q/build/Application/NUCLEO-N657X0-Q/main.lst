1095:Src/main.c    ****     /* The NN runs on a 90deg-CCW-rotated, 3:4-CROPPED frame; the display shows
1096:Src/main.c    ****      * the raw full 4:3 (sideways) camera. Map the box back into display space:
1097:Src/main.c    ****      * undo the rotation (90deg CW) AND undo the crop, else the box is stretched.
1098:Src/main.c    ****      * crop fraction cf = (MH/MW)^2 of the display width; offset centers it.
1099:Src/main.c    ****      *   xc = off + (1 - yu)*cf,  yc = xu,  wc = hu*cf,  hc = wu              */
1100:Src/main.c    ****     const float32_t cf  = ((float32_t)STAI_NETWORK_IN_1_HEIGHT * STAI_NETWORK_IN_1_HEIGHT) /
1101:Src/main.c    ****                           ((float32_t)STAI_NETWORK_IN_1_WIDTH  * STAI_NETWORK_IN_1_WIDTH);
1102:Src/main.c    ****     const float32_t off = (1.0f - cf) * 0.5f;
1103:Src/main.c    ****     float32_t xc = off + (1.0f - rois[i].y_center) * cf;
1104:Src/main.c    ****     float32_t yc = rois[i].x_center;
1105:Src/main.c    ****     float32_t wc = rois[i].height * cf;
1106:Src/main.c    ****     float32_t hc = rois[i].width;
