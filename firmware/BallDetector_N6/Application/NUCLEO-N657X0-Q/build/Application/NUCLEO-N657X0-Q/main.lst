  59:Src/main.c    **** /* Simple (non-tracker) servo control: a PI controller in the velocity-command
  60:Src/main.c    ****  * form. s_us accumulates the command, so GAIN_US*err is INTEGRAL action (zeroes
  61:Src/main.c    ****  * steady-state error for any ball position) and KD_US*(error rate) integrates to
  62:Src/main.c    ****  * a PROPORTIONAL position term that damps the loop. Pure-integral (KD=0) + the
  63:Src/main.c    ****  * ~80ms loop dead-time overshoots and limit-cycles ("swinging"); the KD term and
  64:Src/main.c    ****  * a moderate GAIN_US fix that while STEP_MAX still allows a fast slew for a
  65:Src/main.c    ****  * fast-moving ball. The loop runs at the inference rate (~12 Hz), so top pan
  66:Src/main.c    ****  * speed ~ STEP_MAX[us] * loop_hz / (~11 us/deg) deg/s. */
  67:Src/main.c    **** #define SIMPLE_SIGN      (-1.0f)   /* pan direction toward the ball (verified)   */
  68:Src/main.c    **** #define SIMPLE_SMOOTH     0.50f    /* EMA low-pass on detected x (higher=snappier) */
  69:Src/main.c    **** #define SIMPLE_GAIN_US    220.0f   /* integral gain: us/update per unit error     */
  70:Src/main.c    **** #define SIMPLE_KD_US      350.0f   /* derivative (damping) gain on error rate     */
  71:Src/main.c    **** #define SIMPLE_STEP_MAX   90.0f    /* max us change per update (~95 deg/s @12Hz) */
  72:Src/main.c    **** #define SIMPLE_DEADZONE   0.04f    /* |x-0.5| below this = centered, no move     */
