 171:Src/main.c    **** /* Camera delivers HWC RGB888; balldet input is channel-first (CHW). Capture
 172:Src/main.c    ****  * into this scratch, then transpose into nn_in. */
 173:Src/main.c    **** __attribute__ ((aligned (32)))
 174:Src/main.c    **** static uint8_t nn_hwc[STAI_NETWORK_IN_1_SIZE_BYTES];
 175:Src/main.c    **** 
 176:Src/main.c    **** /* One-shot UART frame dump state. g_dump_req latches a request; the loop then
 177:Src/main.c    ****  * streams the frame in small chunks across iterations (g_dumping/g_dump_off) so
 178:Src/main.c    ****  * a single multi-second blocking transmit never monopolizes the system. */
 179:Src/main.c    **** static volatile uint8_t g_dump_req = 0;
 180:Src/main.c    **** static uint8_t  g_dumping  = 0;
 181:Src/main.c    **** static uint32_t g_dump_off = 0;
 182:Src/main.c    **** 
 183:Src/main.c    **** /* The camera module is mounted rotated 90deg CW, so we capture the frame in the
 184:Src/main.c    ****  * sensor's native (un-stretched) 3:4 orientation -- CAP_W x CAP_H = 288 x 384 --
 185:Src/main.c    ****  * and rotate it 90deg CCW into the model's 384 x 288 (4:3) input. Because the
 186:Src/main.c    ****  * sensor is 4:3 and the model is 4:3, this is a pure rotation: no stretch, balls
 187:Src/main.c    ****  * stay round. Same per-pixel cost as a plain transpose. Also converts HWC->CHW.
 188:Src/main.c    ****  *
 189:Src/main.c    ****  * Dest (model) pixel (mx,my) <- source (capture) pixel (xs,ys):
 190:Src/main.c    ****  *   xs = (CAP_W-1) - my,  ys = mx     (90deg CCW, matches host rot90_ccw). */
 191:Src/main.c    **** #define CAP_W (STAI_NETWORK_IN_1_HEIGHT)   /* 288: capture width  */
 192:Src/main.c    **** #define CAP_H (STAI_NETWORK_IN_1_WIDTH)    /* 384: capture height */
 193:Src/main.c    **** 
 194:Src/main.c    **** static void rotate_ccw_hwc_to_chw(const uint8_t *hwc, uint8_t *chw)
 195:Src/main.c    **** {
 196:Src/main.c    ****   const uint32_t MW = (uint32_t)STAI_NETWORK_IN_1_WIDTH;    /* 384 */
