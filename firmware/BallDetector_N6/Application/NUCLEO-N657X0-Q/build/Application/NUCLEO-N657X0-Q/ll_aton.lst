 185:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   ATON_CLKCTRL_BGATES_SET(0, (1 << ATON_EPOCHCTRL_CLKB_CLK(0)));
 186:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c **** #else
