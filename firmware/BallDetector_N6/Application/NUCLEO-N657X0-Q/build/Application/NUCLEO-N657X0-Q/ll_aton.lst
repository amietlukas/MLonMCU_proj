 288:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   ATON_CLKCTRL_CTRL_SET(0, 0);
 289:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c **** 
 290:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   return 0;
 291:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c **** }
