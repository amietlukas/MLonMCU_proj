 168:../../Middlewares/stm32-mw-camera/cmw_utils.c **** static void CMW_UTILS_get_crop_config(uint32_t cam_width, uint32_t cam_height, uint32_t pipe_width,
 169:../../Middlewares/stm32-mw-camera/cmw_utils.c **** {
 170:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   const float ratio_width = (float)cam_width / pipe_width ;
 171:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   const float ratio_height = (float)cam_height / pipe_height;
 172:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   const float ratio = MIN(ratio_width, ratio_height);
 173:../../Middlewares/stm32-mw-camera/cmw_utils.c **** 
 174:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   assert(ratio >= 1);
 175:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   assert(ratio < 64);
 176:../../Middlewares/stm32-mw-camera/cmw_utils.c **** 
 177:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   crop->HSize = (uint32_t) MIN(pipe_width * ratio, cam_width);
 178:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   crop->VSize = (uint32_t) MIN(pipe_height * ratio, cam_height);
 179:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   crop->HStart = (cam_width - crop->HSize + 1) / 2;
 180:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   crop->VStart = (cam_height - crop->VSize + 1) / 2;
 181:../../Middlewares/stm32-mw-camera/cmw_utils.c ****   crop->PipeArea = DCMIPP_POSITIVE_AREA;
 182:../../Middlewares/stm32-mw-camera/cmw_utils.c **** }
