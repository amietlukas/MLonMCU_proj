 105:Src/app_camerapipeline.c **** #if NN_ROTATE_90
 106:Src/app_camerapipeline.c ****   /* Camera is mounted 90deg rotated: capture in the sensor's native 3:4
 107:Src/app_camerapipeline.c ****    * orientation (model HEIGHT x WIDTH) and rotate 90deg CCW in software (see
 108:Src/app_camerapipeline.c ****    * rotate_ccw_hwc_to_chw). Crop (not fit/stretch) keeps the 4:3 sensor's
 109:Src/app_camerapipeline.c ****    * aspect so balls stay round; main.c rotates this into the 4:3 NN input. */
 110:Src/app_camerapipeline.c ****   dcmipp_conf.output_width = STAI_NETWORK_IN_1_HEIGHT;   /* 288 */
 111:Src/app_camerapipeline.c ****   dcmipp_conf.output_height = STAI_NETWORK_IN_1_WIDTH;   /* 384 */
