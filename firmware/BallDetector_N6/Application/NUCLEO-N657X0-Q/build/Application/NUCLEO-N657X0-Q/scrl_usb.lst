 350:../../Middlewares/screenl/Src/scrl_usb.c **** static int SCRU_validate_parameters(SCRL_LayerConfig *layers_config[SCRL_LAYER_NB], SCRL_ScreenConf
 351:../../Middlewares/screenl/Src/scrl_usb.c **** {
 352:../../Middlewares/screenl/Src/scrl_usb.c ****   int i;
 353:../../Middlewares/screenl/Src/scrl_usb.c **** 
 354:../../Middlewares/screenl/Src/scrl_usb.c ****   /* First check for null pointer */
 355:../../Middlewares/screenl/Src/scrl_usb.c ****   if (!screen_config)
 356:../../Middlewares/screenl/Src/scrl_usb.c ****     return -1;
 357:../../Middlewares/screenl/Src/scrl_usb.c ****   for (i = 0; i < SCRL_LAYER_NB; i++)
 358:../../Middlewares/screenl/Src/scrl_usb.c ****     if (!layers_config[i])
 359:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 360:../../Middlewares/screenl/Src/scrl_usb.c **** 
 361:../../Middlewares/screenl/Src/scrl_usb.c ****   /* Also for adresses */
 362:../../Middlewares/screenl/Src/scrl_usb.c ****   if (!screen_config->address)
 363:../../Middlewares/screenl/Src/scrl_usb.c ****     return -1;
 364:../../Middlewares/screenl/Src/scrl_usb.c ****   for (i = 0; i < SCRL_LAYER_NB; i++)
 365:../../Middlewares/screenl/Src/scrl_usb.c ****     if (!layers_config[i]->address)
 366:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 367:../../Middlewares/screenl/Src/scrl_usb.c **** 
 368:../../Middlewares/screenl/Src/scrl_usb.c ****   /* All layers must have the same size ... */
 369:../../Middlewares/screenl/Src/scrl_usb.c ****   for (i = 1; i < SCRL_LAYER_NB; i++) {
 370:../../Middlewares/screenl/Src/scrl_usb.c ****     if (layers_config[i]->size.width != layers_config[0]->size.width)
 371:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 372:../../Middlewares/screenl/Src/scrl_usb.c ****     if (layers_config[i]->size.height != layers_config[0]->size.height)
 373:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 374:../../Middlewares/screenl/Src/scrl_usb.c ****   }
 375:../../Middlewares/screenl/Src/scrl_usb.c **** 
 376:../../Middlewares/screenl/Src/scrl_usb.c ****   /* ... and same origin */
 377:../../Middlewares/screenl/Src/scrl_usb.c ****   for (i = 1; i < SCRL_LAYER_NB; i++) {
 378:../../Middlewares/screenl/Src/scrl_usb.c ****     if (layers_config[i]->origin.x != layers_config[0]->origin.x)
 379:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 380:../../Middlewares/screenl/Src/scrl_usb.c ****     if (layers_config[i]->origin.y != layers_config[0]->origin.y)
 381:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 382:../../Middlewares/screenl/Src/scrl_usb.c ****   }
 383:../../Middlewares/screenl/Src/scrl_usb.c **** 
 384:../../Middlewares/screenl/Src/scrl_usb.c ****   /* layers must fully fit in screen. Only check with layer0 since layers have same size and origin
 385:../../Middlewares/screenl/Src/scrl_usb.c ****   if (layers_config[0]->size.width + layers_config[0]->origin.x > screen_config->size.width)
 386:../../Middlewares/screenl/Src/scrl_usb.c ****     return -1;
 387:../../Middlewares/screenl/Src/scrl_usb.c ****   if (layers_config[0]->size.height + layers_config[0]->origin.y > screen_config->size.height)
 388:../../Middlewares/screenl/Src/scrl_usb.c ****     return -1;
 389:../../Middlewares/screenl/Src/scrl_usb.c **** 
 390:../../Middlewares/screenl/Src/scrl_usb.c ****   /* check input format */
 391:../../Middlewares/screenl/Src/scrl_usb.c ****   for (i = 0; i < SCRL_LAYER_NB; i++)
 392:../../Middlewares/screenl/Src/scrl_usb.c ****     if (!is_layer_format_valid(layers_config[i]->format))
 393:../../Middlewares/screenl/Src/scrl_usb.c ****       return -1;
 394:../../Middlewares/screenl/Src/scrl_usb.c **** 
 395:../../Middlewares/screenl/Src/scrl_usb.c ****   /* check output format */
 396:../../Middlewares/screenl/Src/scrl_usb.c ****   if (!is_output_format_valid(screen_config->format))
 397:../../Middlewares/screenl/Src/scrl_usb.c ****     return -1;
 398:../../Middlewares/screenl/Src/scrl_usb.c **** 
 399:../../Middlewares/screenl/Src/scrl_usb.c ****   return 0;
ARM GAS  /tmp/claude-1000/cc2LJ7uj.s 			page 21


