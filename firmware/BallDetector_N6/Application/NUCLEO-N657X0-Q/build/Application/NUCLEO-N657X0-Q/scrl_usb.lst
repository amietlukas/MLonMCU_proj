 137:../../Middlewares/screenl/Src/scrl_usb.c **** static void SCRU_cvt_dual_pel_rgb_to_yuv(uint8_t *r, uint8_t *g, uint8_t *b, int32_t *y, int32_t *c
 138:../../Middlewares/screenl/Src/scrl_usb.c **** {
 139:../../Middlewares/screenl/Src/scrl_usb.c ****   uint8_t red, green, blue;
ARM GAS  /tmp/claude-1000/cc2LJ7uj.s 			page 4


 140:../../Middlewares/screenl/Src/scrl_usb.c **** 
 141:../../Middlewares/screenl/Src/scrl_usb.c ****   RGB_2_Y(r[0], g[0], b[0], y[0]);
 142:../../Middlewares/screenl/Src/scrl_usb.c ****   RGB_2_Y(r[1], g[1], b[1], y[1]);
 143:../../Middlewares/screenl/Src/scrl_usb.c **** 
 144:../../Middlewares/screenl/Src/scrl_usb.c ****   red = (r[0] + r[1] + 1) / 2;
 145:../../Middlewares/screenl/Src/scrl_usb.c ****   green = (g[0] + g[1] + 1) / 2;
 146:../../Middlewares/screenl/Src/scrl_usb.c ****   blue = (b[0] + b[1] + 1) / 2;
 147:../../Middlewares/screenl/Src/scrl_usb.c **** 
 148:../../Middlewares/screenl/Src/scrl_usb.c ****   RGB_2_CR(red, green, blue, cr[0]);
 149:../../Middlewares/screenl/Src/scrl_usb.c ****   RGB_2_CB(red, green, blue, cb[0]);
 150:../../Middlewares/screenl/Src/scrl_usb.c **** }
