 578:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****       ISP_GatherStatistics(&((CMW_VD1943_t *)io_ctx)->hIsp);
 579:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****       break;
