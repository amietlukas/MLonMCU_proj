 202:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** /**
 203:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****  * @brief  Set the gain
 204:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****  * @param  pObj  pointer to component object
 205:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****  * @param  Gain Gain in mdB
 206:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****  * @retval Component status
 207:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****  */
 208:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** int32_t CMW_VD1943_SetGain(void *io_ctx, int32_t gain)
 209:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** {
 210:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   int32_t ret;
 211:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   uint32_t again_min_mdB, again_max_mdB;
 212:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   uint32_t dgain_min_mdB, dgain_max_mdB;
 213:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   double analog_linear_gain, digital_linear_gain;
 214:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   double again_reg_f;
 215:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   unsigned int again_reg;
 216:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** 
 217:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   again_min_mdB = (uint32_t) LINEAR_TO_MDECIBEL(16.0 / (16.0 - (double)VD1943_ANALOG_GAIN_MIN));
 218:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   again_max_mdB = (uint32_t) LINEAR_TO_MDECIBEL(16.0 / (16.0 - (double)VD1943_ANALOG_GAIN_MAX));
 219:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   dgain_min_mdB = (uint32_t) LINEAR_TO_MDECIBEL(FP58_TO_FLOAT(VD1943_DIGITAL_GAIN_MIN));
 220:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   dgain_max_mdB = (uint32_t) LINEAR_TO_MDECIBEL(FP58_TO_FLOAT(VD1943_DIGITAL_GAIN_MAX));
 221:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** 
 222:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   if ((gain < dgain_min_mdB + again_min_mdB) || (gain > dgain_max_mdB + again_max_mdB))
 223:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     return -1;
 224:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** 
 225:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   if (gain <= again_max_mdB)
 226:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   {
 227:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     /* Use analog gain only and set digital gain to its minimum */
 228:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     analog_linear_gain = MDECIBEL_TO_LINEAR((double)(gain - dgain_min_mdB));
 229:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     digital_linear_gain = MDECIBEL_TO_LINEAR((double)dgain_min_mdB);
 230:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     /* Take care to rounding issue */
 231:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     again_reg_f = 16.0 - (16.0 / analog_linear_gain);
 232:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     again_reg = (unsigned int)(again_reg_f + 0.5);
 233:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     if (again_reg > VD1943_ANALOG_GAIN_MAX)
 234:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****       again_reg = VD1943_ANALOG_GAIN_MAX;
 235:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   }
 236:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   else
 237:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   {
 238:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     /* Analog saturated, remainder goes to digital */
 239:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     again_reg = VD1943_ANALOG_GAIN_MAX;
 240:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     digital_linear_gain = MDECIBEL_TO_LINEAR((double)(gain - again_max_mdB));
 241:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   }
 242:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** 
 243:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   ret = VD1943_SetAnalogGain(&((CMW_VD1943_t *)io_ctx)->ctx_driver, again_reg);
 244:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   if (ret)
 245:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     return ret;
 246:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** 
 247:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   ret = VD1943_SetDigitalGain(&((CMW_VD1943_t *)io_ctx)->ctx_driver,
 248:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****                               FLOAT_TO_FP58(digital_linear_gain));
 249:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   if (ret)
 250:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     return ret;
 251:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** 
 252:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   return 0;
 253:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** }
