 567:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** static void CMW_VD1943_VsyncEventCallback(void *io_ctx, uint32_t pipe)
 568:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** {
 569:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c **** #ifndef ISP_MW_TUNING_TOOL_SUPPORT
 570:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   /* Update the ISP frame counter and call its statistics handler */
 571:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   switch (pipe)
 572:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****   {
 573:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****     case DCMIPP_PIPE0 :
 574:../../Middlewares/stm32-mw-camera/sensors/cmw_vd1943.c ****       ISP_IncDumpFrameId(&((CMW_VD1943_t *)io_ctx)->hIsp);
